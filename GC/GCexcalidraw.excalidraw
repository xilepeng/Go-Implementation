    {
      "id": "fhccSEU-cmOr0s92ZuSIq",
      "type": "text",
      "x": -158.399945605501,
      "y": -14204.689938210031,
      "width": 1299.635986328125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

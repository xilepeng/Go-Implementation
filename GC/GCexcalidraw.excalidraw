      "seed": 1432213030,
      "version": 235,
      "versionNonce": 608143482,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753240914215,
      "link": null,
      "locked": false,
      "text": "1. 程序起初创建对象，对象全部标记为白色，将所有对象全部放入白色标记表中；",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 程序起初创建对象，对象全部标记为白色，将所有对象全部放入白色标记表中；",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7vQzq6k2cdjVUinKRyehd",
      "type": "text",
      "x": -161.03367170346723,
      "y": -13119.745698517818,
      "width": 1237.4998779296875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bS0",
      "roundness": null,
      "seed": 277458874,
      "version": 170,
      "versionNonce": 1404170362,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753240910966,
      "link": null,
      "locked": false,
      "text": "2. 遍历 RootSet 根节点集合，得到灰色节点，将灰色对象加入灰色标记表；",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. 遍历 RootSet 根节点集合，得到灰色节点，将灰色对象加入灰色标记表；",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i770XL7Wzjpz4BUKo9CNO",
      "type": "text",
      "x": -148.39268985621106,
      "y": -11952.714593034701,
      "width": 1391.2299827067789,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bS1",
      "roundness": null,
      "seed": 1637771002,
      "version": 242,
      "versionNonce": 2115649978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753240884731,
      "link": null,
      "locked": false,
      "text": "3. 遍历灰色标记表，将可达对象从白色标记为灰色，将遍历过的灰色标记为黑色；",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. 遍历灰色标记表，将可达对象从白色标记为灰色，将遍历过的灰色标记为黑色；",
      "autoResize": false,
      "lineHeight": 1.25
    },
